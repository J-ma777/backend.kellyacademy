# =========================================
# KELLY ACADEMY LMS - Variables de entorno (EJEMPLO)
# =========================================
#
# INSTRUCCIONES:
# 1. Copia este archivo a ".env"
# 2. Reemplaza los valores "changeme" por tus valores reales
# 3. NUNCA comitees el archivo ".env"

# -----------------------------------------
# Base de datos PostgreSQL
# -----------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/kelly_academy
DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_DRIVER=org.postgresql.Driver

# -----------------------------------------
# JWT
# -----------------------------------------
JWT_SECRET=generate-with-openssl-rand-base64-64
JWT_EXPIRATION=3600000

# CORS
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Cloudinary: obtener en Product environment > API Keys. No comitear .env.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# R2: bucket privado; token limitado a Object Read & Write en ese bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_REGION=auto
# URL pública del backend usada para referencias estables.
APP_PUBLIC_URL=http://localhost:8080

# Docker configura http://documentos:3000 automáticamente.
# En ejecución desde el IDE, configura aquí la URL de un conversor privado accesible.
DOCUMENT_CONVERTER_URL=
